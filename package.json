{
  "name": "covenant-40-day",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "content:load": "node scripts/load-content.ts",
    "media:compress": "node scripts/compress-media.ts",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-sync-storage-persister": "5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "4.4.0",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "10.1.0",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.23.0",
    "sharp": "^0.35.5",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
