# Copy to .env.local for local development. `supabase start` (or `supabase status`) prints both values.
# On Vercel: previews use c40-staging, production uses c40-prod.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. Safe in the browser because RLS protects every table.
VITE_SUPABASE_ANON_KEY=

# Never put the service role (secret) key in a VITE_ variable: those end up in the browser bundle.
# Scripts read it from .env.local, .env.staging or .env.prod (all gitignored) as SUPABASE_SERVICE_ROLE_KEY.
